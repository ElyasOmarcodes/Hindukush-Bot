# ⚠️ دا یوازې یو **نمونه** فایل دی — رینیم کولو ته یې اړتیا نشته!
#
#  • GitHub Actions کې: هیڅ فایل مه جوړوه. دا نومونه په
#    Settings → Secrets and variables → Actions کې ثبت کړه. بس همدومره.
#  • خپل کمپیوټر کې (local): یوه کاپي جوړه کړه او نوم یې `.env` (یا `env`) کړه.
#    دواړه نومونه ګیټ-ایګنور شوي دي — هیڅکله ګیټ ته نه ځي.
#
# ⚠️ This is only a SAMPLE — you do NOT need to rename it.
#   • On GitHub Actions: create no file. Add these names as repository Secrets.
#   • Locally: copy it to `.env` (or `env`). Both are gitignored.

# د BotFather ټوکن / Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# د ګروپ ID (منفي عدد) / target group id (negative number, e.g. -1001234567890)
TELEGRAM_GROUP_ID=

# د مجازو کاروونکو ID، په کامې سره جلا / comma-separated allowed user ids.
# که تش وي، هرڅوک رباټ کارولی شي. If empty, everyone may use the bot.
#   ADMIN_USER_IDS=111111111,222222222,333333333
ADMIN_USER_IDS=

# د Gemini کیلیانې — په کامې (,) سره جلا. هر شمیر کیلي منل کیږي (۲، ۳، یا زیاتې).
# cascade به هر مډل لپاره په ترتیب سره کیلي#۱ → کیلي#۲ → کیلي#۳ … هڅه کوي.
# Comma-separated Gemini API keys (any number: 2, 3, or more). Example:
#   GEMINI_API_KEYS=AIzaKEY_ONE,AIzaKEY_TWO,AIzaKEY_THREE
GEMINI_API_KEYS=
