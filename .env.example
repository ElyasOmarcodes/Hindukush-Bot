# د دې فایل یوه کاپي جوړه کړه او نوم یې `.env` کړه، بیا خپلې کیلیانې ورکړه.
# Copy this file to `.env` and fill in your real values. `.env` is gitignored.

# د BotFather ټوکن / Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# د ګروپ ID (منفي عدد) / target group id (negative number, e.g. -1001234567890)
TELEGRAM_GROUP_ID=

# د اډمینانو د کاروونکو ID، په کامې سره جلا (اختیاري) / comma-separated admin user ids (optional)
ADMIN_USER_IDS=

# د Gemini کیلیانې — په کامې (,) سره جلا. هر شمیر کیلي منل کیږي (۲، ۳، یا زیاتې).
# cascade به هر مډل لپاره په ترتیب سره کیلي#۱ → کیلي#۲ → کیلي#۳ … هڅه کوي.
# Comma-separated Gemini API keys (any number: 2, 3, or more). Example:
#   GEMINI_API_KEYS=AIzaKEY_ONE,AIzaKEY_TWO,AIzaKEY_THREE
GEMINI_API_KEYS=
